-		fLogicalH = SWEET_FB_LOGICAL_H;
+	fScaleUp = false;
+	fScaleX = fScaleY = 0;
+	fInvScaleX = fInvScaleY = 0;
+	if (!native) {
+		/*
+		 * The canvas the userland renders at: /arm-io/disp0
+		 * canvas-width/canvas-height (the properties
+		 * IOMobileFramebuffer.framework reads for the same thing).
+		 * GetDisplaySize(8) has to report exactly this size, or the
+		 * render target and the display mode disagree and backboardd
+		 * swaps empty frames (the "no picture, no crash" case).
+		 */
+		OSNumber *cw = OSDynamicCast(OSNumber, provider->getProperty("canvas-width"));
+		OSNumber *ch = OSDynamicCast(OSNumber, provider->getProperty("canvas-height"));
+		if (cw != NULL && ch != NULL) {
+			uint32_t w = cw->unsigned32BitValue();
+			uint32_t h = ch->unsigned32BitValue();
+			if (w > 0 && h > 0) {
+				fLogicalW = w;
+				fLogicalH = h;
