+/*
+ * Bring-up aid, boot-arg applog=1: what applications and other programs started without a
+ * terminal say is worth reading. Their standard output and error, which launchd opens on
+ * /dev/null, go to the console instead (NSLog, "Terminating app due to uncaught exception").
+ * (From the HackiOS kernel, same xnu-8796 base.)
+ */
+static TUNABLE(uint32_t, exec_applog, "applog", 0);
+
+static const char *
+exec_applog_path(int fd, const char *path)
+{
+	if (exec_applog && (fd == 1 || fd == 2) && strcmp(path, "/dev/null") == 0) {
+		return "/dev/console";
+	}
+	return path;
+}
