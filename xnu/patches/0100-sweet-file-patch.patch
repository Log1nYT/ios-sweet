--- /dev/null
+++ b/bsd/dev/sweet_file_patch.c
@@ -0,0 +1,572 @@
+/*
+ * sweet: boot-time file patcher (+ file dump).
+ *
+ * The iOS userland image is not on the Mac any more (the 9 GB userdata
+ * image was lost), so every change to a file that lives on the phone's
+ * root volume has to be delivered by the kernel.  This patcher does that:
+ * it rewrites a few bytes in a file after the volume is mounted, using the
+ * in-kernel VFS API (vnode_open + vn_rdwr).
+ *
+ * Boot arguments:
+ *
+ *   sweetfilepatch=<path>:<off>:<oldhex>:<newhex>[,<path>:<off>:<oldhex>:<newhex>...]
+ *   sweetfiledump=<path>[:<off>[:<len>]][,...]
+ *
+ * <off> is hexadecimal, <oldhex>/<newhex> are hex byte strings of the same
+ * length.  The old bytes are verified before the write: if the file does
+ * not contain them we log a mismatch and leave the file alone, so a
+ * different build of the same binary is never corrupted.
+ *
+ * The path alias "mad" expands to /private/usr/libexec/mobileactivationd
+ * to keep the kernel command line short.
+ *
+ * The patch thread starts with the root device driver, long before the
+ * root volume is mounted, so it retries until the file shows up.  Every
+ * attempt is logged (the console log only starts streaming over USB a
+ * couple of seconds later, so the status is repeated for a while).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <libkern/libkern.h>
+#include <sys/uio.h>
+#include <sys/vnode.h>
+#include <sys/kauth.h>
+#include <sys/stat.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+
+void sweet_filepatch_init(void);
+
+#define SFP_MAX_PATCH   8
+#define SFP_MAX_BYTES   16
+#define SFP_PATHLEN     160
+#define SFP_ARGLEN      256
+#define SFP_DUMPLEN     64
+
+struct sfp_patch {
+	char     path[SFP_PATHLEN];
+	uint64_t off;
+	uint32_t len;
+	uint8_t  oldb[SFP_MAX_BYTES];
+	uint8_t  newb[SFP_MAX_BYTES];
+	int      done;
+	int      err;
+};
+
+static struct sfp_patch sfp[SFP_MAX_PATCH];
+static int sfp_count;
+
+static void
+sfp_expand(const char *path, char *out, int outlen)
+{
+	if (strcmp(path, "mad") == 0) {
+		strlcpy(out, "/private/usr/libexec/mobileactivationd", outlen);
+	} else {
+		strlcpy(out, path, outlen);
+	}
+}
+
+static int
+sfp_hexval(int c)
+{
+	if (c >= '0' && c <= '9') {
+		return c - '0';
+	}
+	if (c >= 'a' && c <= 'f') {
+		return c - 'a' + 10;
+	}
+	if (c >= 'A' && c <= 'F') {
+		return c - 'A' + 10;
+	}
+	return -1;
+}
+
+static int
+sfp_unhex(const char *hex, uint8_t *buf, int max)
+{
+	int n = 0;
+
+	while (hex[0] != '\0' && hex[1] != '\0' && n < max) {
+		int hi = sfp_hexval((unsigned char)hex[0]);
+		int lo = sfp_hexval((unsigned char)hex[1]);
+		if (hi < 0 || lo < 0) {
+			return -1;
+		}
+		buf[n++] = (uint8_t)((hi << 4) | lo);
+		hex += 2;
+	}
+	return (hex[0] == '\0') ? n : -1;
+}
+
+static uint64_t
+sfp_parse_off(const char *s)
+{
+	uint64_t v = 0;
+	int any = 0;
+
+	for (;;) {
+		int d = sfp_hexval((unsigned char)*s);
+		if (d < 0) {
+			break;
+		}
+		v = (v << 4) | (uint64_t)d;
+		any = 1;
+		s++;
+	}
+	return any ? v : (uint64_t)-1;
+}
+
+static void
+sfp_add(const char *path, uint64_t off, const char *oldhex, const char *newhex)
+{
+	struct sfp_patch *p;
+	int oldlen, newlen;
+
+	if (sfp_count >= SFP_MAX_PATCH) {
+		printf("SWEET FILEPATCH: too many patches\n");
+		return;
+	}
+	p = &sfp[sfp_count];
+	oldlen = sfp_unhex(oldhex, p->oldb, SFP_MAX_BYTES);
+	newlen = sfp_unhex(newhex, p->newb, SFP_MAX_BYTES);
+	if (oldlen <= 0 || oldlen != newlen) {
+		printf("SWEET FILEPATCH: bad hex in \"%s\"\n", path);
+		return;
+	}
+	p->len = (uint32_t)oldlen;
+	p->off = off;
+	sfp_expand(path, p->path, SFP_PATHLEN);
+	sfp_count++;
+}
+
+static void
+sfp_parse(char *spec)
+{
+	char *p = spec;
+
+	while (p != NULL && *p != '\0') {
+		char *comma = strchr(p, ',');
+		char *c1, *c2, *c3;
+
+		if (comma != NULL) {
+			*comma = '\0';
+		}
+		c1 = strchr(p, ':');
+		if (c1 == NULL) {
+			break;
+		}
+		*c1++ = '\0';
+		c2 = strchr(c1, ':');
+		if (c2 == NULL) {
+			break;
+		}
+		*c2++ = '\0';
+		c3 = strchr(c2, ':');
+		if (c3 == NULL) {
+			break;
+		}
+		*c3++ = '\0';
+		sfp_add(p, sfp_parse_off(c1), c2, c3);
+		p = (comma != NULL) ? comma + 1 : NULL;
+	}
+}
+
+/* Read len bytes at offset; returns 0 on success. */
+static int
+sfp_read(vnode_t vp, void *buf, uint32_t len, uint64_t off)
+{
+	int resid = 0;
+	int err;
+
+	err = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)len, (off_t)off,
+	    UIO_SYSSPACE, IO_NODELOCKED | IO_NOAUTH, kauth_cred_get(), &resid, NULL);
+	if (err != 0) {
+		return err;
+	}
+	return (resid != 0) ? EIO : 0;
+}
+
+static int
+sfp_write(vnode_t vp, const void *buf, uint32_t len, uint64_t off)
+{
+	int resid = 0;
+	int err;
+
+	err = vn_rdwr(UIO_WRITE, vp, (caddr_t)buf, (int)len, (off_t)off,
+	    UIO_SYSSPACE, IO_NODELOCKED | IO_NOAUTH, kauth_cred_get(), &resid, NULL);
+	if (err != 0) {
+		return err;
+	}
+	return (resid != 0) ? EIO : 0;
+}
+
+/* Dump a region of a file as hex, so we can see what is on the phone. */
+static int
+sfp_dump_one(char *spec)
+{
+	char path[SFP_PATHLEN];
+	char *c1, *c2;
+	uint64_t off = 0;
+	uint32_t len = SFP_DUMPLEN;
+	uint8_t buf[SFP_DUMPLEN];
+	vnode_t vp = NULL;
+	vfs_context_t ctx = vfs_context_kernel();
+	int err, i;
+
+	c1 = strchr(spec, ':');
+	if (c1 != NULL) {
+		*c1++ = '\0';
+		c2 = strchr(c1, ':');
+		if (c2 != NULL) {
+			*c2++ = '\0';
+			uint64_t l = sfp_parse_off(c2);
+			len = (l == (uint64_t)-1) ? SFP_DUMPLEN : (uint32_t)l;
+		}
+		off = sfp_parse_off(c1);
+		if (off == (uint64_t)-1) {
+			off = 0;
+		}
+	}
+	if (len == 0 || len > SFP_DUMPLEN) {
+		len = SFP_DUMPLEN;
+	}
+	sfp_expand(spec, path, SFP_PATHLEN);
+	err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (err != 0) {
+		printf("SWEET FILEDUMP: %s open failed (err %d)\n", path, err);
+		return 1;
+	}
+	err = sfp_read(vp, buf, len, off);
+	if (err != 0) {
+		printf("SWEET FILEDUMP: %s read@0x%llx failed (err %d)\n",
+		    path, (unsigned long long)off, err);
+		vnode_close(vp, 0, ctx);
+		return 1;
+	}
+	printf("SWEET FILEDUMP: %s@0x%llx:", path, (unsigned long long)off);
+	for (i = 0; i < (int)len; i++) {
+		printf(" %02x", buf[i]);
+	}
+	printf("\n");
+	vnode_close(vp, 0, ctx);
+	return 0;
+}
+
+static char sfp_dump_spec[SFP_ARGLEN];
+
+/* Returns the number of dumps that failed (ENOENT etc). */
+static int
+sfp_dump_run(void)
+{
+	char spec[SFP_ARGLEN];
+	char *p;
+	int failed = 0;
+
+	strlcpy(spec, sfp_dump_spec, SFP_ARGLEN);
+	p = spec;
+	while (p != NULL && *p != '\0') {
+		char *comma = strchr(p, ',');
+		if (comma != NULL) {
+			*comma = '\0';
+		}
+		failed += sfp_dump_one(p);
+		p = (comma != NULL) ? comma + 1 : NULL;
+	}
+	return failed;
+}
+
+static int
+sfp_apply(struct sfp_patch *p)
+{
+	vnode_t vp = NULL;
+	vfs_context_t ctx = vfs_context_kernel();
+	uint8_t buf[SFP_MAX_BYTES];
+	int err;
+
+	err = vnode_open(p->path, FREAD | FWRITE, 0, 0, &vp, ctx);
+	if (err != 0) {
+		return err;
+	}
+	err = sfp_read(vp, buf, p->len, p->off);
+	if (err != 0) {
+		printf("SWEET FILEPATCH: read %s@0x%llx failed (err %d)\n",
+		    p->path, (unsigned long long)p->off, err);
+		vnode_close(vp, 0, ctx);
+		return err;
+	}
+	if (memcmp(buf, p->oldb, p->len) != 0) {
+		printf("SWEET FILEPATCH: %s@0x%llx MISMATCH (have %02x%02x%02x%02x,"
+		    " want %02x%02x%02x%02x) - skipped\n",
+		    p->path, (unsigned long long)p->off,
+		    (p->len > 0) ? buf[0] : 0, (p->len > 1) ? buf[1] : 0,
+		    (p->len > 2) ? buf[2] : 0, (p->len > 3) ? buf[3] : 0,
+		    (p->len > 0) ? p->oldb[0] : 0, (p->len > 1) ? p->oldb[1] : 0,
+		    (p->len > 2) ? p->oldb[2] : 0, (p->len > 3) ? p->oldb[3] : 0);
+		vnode_close(vp, 0, ctx);
+		return EIO;
+	}
+	err = sfp_write(vp, p->newb, p->len, p->off);
+	if (err != 0) {
+		printf("SWEET FILEPATCH: write %s@0x%llx failed (err %d)\n",
+		    p->path, (unsigned long long)p->off, err);
+		vnode_close(vp, 0, ctx);
+		return err;
+	}
+	printf("SWEET FILEPATCH: patched %s@0x%llx (%u bytes)\n",
+	    p->path, (unsigned long long)p->off, p->len);
+	vnode_close(vp, 0, ctx);
+	return 0;
+}
+
+
+/*
+ * Write a file (create or truncate) with the given bytes.  This is how we
+ * seed userland state that the iOS root image does not carry (the sweet
+ * project put the same keys into the image with sweet-root-tweaks.py; the
+ * image is gone, so the kernel does it now).
+ */
+static int
+sfp_write_file(const char *path, const void *buf, uint32_t len,
+    uint32_t uid, uint32_t gid, uint32_t mode)
+{
+	vnode_t vp = NULL;
+	vfs_context_t ctx = vfs_context_kernel();
+	int resid = 0;
+	int err;
+
+	err = vnode_open(path, FWRITE | O_CREAT | O_TRUNC, 0644, 0, &vp, ctx);
+	if (err != 0) {
+		return err;
+	}
+	err = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)buf, (int)len, 0, UIO_SYSSPACE,
+	    IO_NODELOCKED | IO_NOAUTH, kauth_cred_get(), &resid, NULL);
+	if (err == 0 && resid != 0) {
+		err = EIO;
+	}
+	if (err == 0) {
+		struct vnode_attr va;
+
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_mode, (mode_t)mode);
+		VATTR_SET(&va, va_uid, uid);
+		VATTR_SET(&va, va_gid, gid);
+		/* truncate: the old file may have been longer */
+		VATTR_SET(&va, va_data_size, (uint64_t)len);
+		(void)vnode_setattr(vp, &va, ctx);
+	}
+	vnode_close(vp, 0, ctx);
+	return err;
+}
+
+/*
+ * The upstream sweet project skips the iOS setup flow with these
+ * preferences (tools/sweet-root-tweaks.py): SetupDone/SetupFinishedAllSteps
+ * true and SetupVersion 11 in com.apple.purplebuddy, the mini-buddy flags
+ * off in com.apple.purplebuddy.notbackedup, and the cloud configuration UI
+ * disabled in com.apple.managedconfiguration.notbackedup.  The phone
+ * rewrites com.apple.purplebuddy.plist during every boot (SetupVersion
+ * becomes 21 and SetupDone is dropped), so they have to be written before
+ * userland starts.
+ */
+static const char sfp_pb[] =
+    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\""
+    " \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+    "<plist version=\"1.0\"><dict>"
+    "<key>SetupDone</key><true/>"
+    "<key>SetupFinishedAllSteps</key><true/>"
+    "<key>SetupVersion</key><integer>11</integer>"
+    "<key>daemonizeNeedsToRun</key><false/>"
+    "</dict></plist>\n";
+
+static const char sfp_pbn[] =
+    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\""
+    " \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+    "<plist version=\"1.0\"><dict>"
+    "<key>ShouldRunDiagnosticsMiniBuddy</key><false/>"
+    "<key>ShouldRunHSA2MiniBuddy</key><false/>"
+    "<key>ShouldRunKeychainSyncMiniBuddy</key><false/>"
+    "<key>ShouldRunMesaMiniBuddy</key><false/>"
+    "<key>ShouldRunPaymentMiniBuddy</key><false/>"
+    "<key>ShouldRunStandardMiniBuddy</key><false/>"
+    "<key>SilentICDPUpgrade</key><false/>"
+    "</dict></plist>\n";
+
+static const char sfp_mcn[] =
+    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\""
+    " \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+    "<plist version=\"1.0\"><dict>"
+    "<key>LockdownActivationIndicatesCloudConfigurationAvailable</key><false/>"
+    "</dict></plist>\n";
+
+/*
+ * The activation record ("data ark") that mobileactivationd reads.  The
+ * daemon's own default is patched to "Activated" as well, but the file is
+ * what the daemon and UserManagerDaemon look at.
+ */
+static const char sfp_ark[] =
+    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\""
+    " \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+    "<plist version=\"1.0\"><dict>"
+    "<key>ActivationState</key><string>Activated</string>"
+    "<key>-ActivationState</key><string>Activated</string>"
+    "<key>BrickState</key><false/>"
+    "<key>-BrickState</key><false/>"
+    "<key>BuildVersion</key><string>20H392</string>"
+    "<key>ProductVersion</key><string>16.7.16</string>"
+    "<key>DataMigrationCompleted</key><true/>"
+    "<key>PreSydroDataMigrationCompleted</key><true/>"
+    "<key>DisableHactivation</key><false/>"
+    "</dict></plist>\n";
+
+static const struct {
+	const char *path;
+	const char *data;
+	uint32_t    uid;
+	uint32_t    gid;
+	uint32_t    mode;
+} sfp_setupfix[] = {
+	{ "/private/var/mobile/Library/Preferences/com.apple.purplebuddy.plist",
+	    sfp_pb, 501, 501, 0600 },
+	{ "/private/var/mobile/Library/Preferences/com.apple.purplebuddy.notbackedup.plist",
+	    sfp_pbn, 501, 501, 0600 },
+	{ "/private/var/mobile/Library/Preferences/com.apple.managedconfiguration.notbackedup.plist",
+	    sfp_mcn, 501, 501, 0600 },
+	{ "/private/var/mobile/Library/mad/data_ark.plist",
+	    sfp_ark, 501, 501, 0600 },
+	{ "/private/var/containers/Data/System/D90C94C4-F94E-4FCF-8A28-A93BE3846D8E"
+	    "/Library/internal/data_ark.plist",
+	    sfp_ark, 501, 501, 0600 },
+};
+
+static int sfp_setupfix_err[sizeof(sfp_setupfix) / sizeof(sfp_setupfix[0])];
+
+/* Write the setup-skipping preferences and the activation record. */
+static void
+sfp_setupfix_run(void)
+{
+	for (unsigned int i = 0; i < sizeof(sfp_setupfix) / sizeof(sfp_setupfix[0]); i++) {
+		int err = sfp_write_file(sfp_setupfix[i].path, sfp_setupfix[i].data,
+		    (uint32_t)strlen(sfp_setupfix[i].data), sfp_setupfix[i].uid,
+		    sfp_setupfix[i].gid, sfp_setupfix[i].mode);
+		sfp_setupfix_err[i] = err;
+		printf("SWEET SETUPFIX: %s -> %s (err %d)\n", sfp_setupfix[i].path,
+		    err == 0 ? "written" : "FAILED", err);
+	}
+}
+
+/* Repeat the status for a while: the console log only comes up later. */
+static void
+sfp_setupfix_report(void)
+{
+	for (unsigned int i = 0; i < sizeof(sfp_setupfix) / sizeof(sfp_setupfix[0]); i++) {
+		printf("SWEET SETUPFIX: %s -> %s (err %d)\n", sfp_setupfix[i].path,
+		    sfp_setupfix_err[i] == 0 ? "written" : "FAILED", sfp_setupfix_err[i]);
+	}
+}
+
+static void
+sfp_thread(void *arg, wait_result_t result)
+{
+	int tries, i;
+
+	(void)arg;
+	(void)result;
+
+	{
+		int fix = 0;
+		/*
+		 * Wait for the USB console log to come up before we do the
+		 * work: prints from this early in the boot are lost, and we
+		 * need to see whether the writes worked.
+		 */
+		if (PE_parse_boot_argn("sweetsetupfix", &fix, sizeof(fix)) && fix) {
+			/*
+			 * Write right away (UserManagerDaemon reads the
+			 * preferences early), then keep rewriting for a
+			 * while: cfprefsd replaces the file during the
+			 * boot, and the console log only comes up later, so
+			 * the status is repeated as well.
+			 */
+			sfp_setupfix_run();
+			for (int r = 0; r < 20; r++) {
+				delay(2 * 1000 * 1000);
+				sfp_setupfix_run();
+				sfp_setupfix_report();
+			}
+		}
+	}
+	if (sfp_dump_spec[0] != '\0') {
+		for (tries = 0; tries < 60; tries++) {
+			if (sfp_dump_run() == 0) {
+				break;
+			}
+			delay(1000 * 1000);
+		}
+	}
+	for (tries = 0; tries < 300; tries++) {
+		int pending = 0;
+
+		for (i = 0; i < sfp_count; i++) {
+			if (sfp[i].done) {
+				continue;
+			}
+			pending++;
+			sfp[i].err = sfp_apply(&sfp[i]);
+			if (sfp[i].err == 0) {
+				sfp[i].done = 1;
+			}
+		}
+		if (pending == 0) {
+			break;
+		}
+		/* repeat the status: the USB console log only comes up later */
+		if ((tries % 10) == 0) {
+			for (i = 0; i < sfp_count; i++) {
+				printf("SWEET FILEPATCH: try %d %s@0x%llx err %d\n",
+				    tries, sfp[i].path, (unsigned long long)sfp[i].off,
+				    sfp[i].err);
+			}
+		}
+		/* the root volume is mounted a little after this thread starts */
+		delay(1000 * 1000);
+	}
+	for (i = 0; i < sfp_count; i++) {
+		printf("SWEET FILEPATCH: %s@0x%llx %s (err %d)\n", sfp[i].path,
+		    (unsigned long long)sfp[i].off,
+		    sfp[i].done ? "PATCHED" : "NOT PATCHED", sfp[i].err);
+	}
+	printf("SWEET FILEPATCH: done\n");
+}
+
+void
+sweet_filepatch_init(void)
+{
+	char spec[SFP_ARGLEN];
+	thread_t t;
+
+	if (PE_parse_boot_argn("sweetfilepatch", spec, sizeof(spec))) {
+		sfp_parse(spec);
+	}
+	if (PE_parse_boot_argn("sweetfiledump", spec, sizeof(spec))) {
+		strlcpy(sfp_dump_spec, spec, SFP_ARGLEN);
+	}
+	if (sfp_count == 0 && sfp_dump_spec[0] == '\0') {
+		return;
+	}
+	printf("SWEET FILEPATCH: %d patch(es) queued\n", sfp_count);
+	if (kernel_thread_start(sfp_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	} else {
+		printf("SWEET FILEPATCH: thread start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
