venus 0128: boot-arg sweetnovibrancy=1 (donor idea): the lock screen needs no GPU-only CoreImage path

SpringBoard dies with pc 0 inside CI::GLContext::init when CoverSheet creates its vibrant
clock (no OpenGL ES here).  With sweetnovibrancy=1 the file-patch thread writes ONE NEW
managed preference, /private/var/Managed Preferences/mobile/com.apple.springboard.plist
(BSUIVibrancyEffectViewDisabled = true).  No existing file is touched.  Needs sweetfilepatch
or sweetnovibrancy to start the thread.

diff --git a/bsd/dev/sweet_file_patch.c b/bsd/dev/sweet_file_patch.c
index 30b3fa2..25dbfba 100644
--- a/bsd/dev/sweet_file_patch.c
+++ b/bsd/dev/sweet_file_patch.c
@@ -450,6 +450,23 @@ static const struct {
 
 static int sfp_setupfix_err[sizeof(sfp_setupfix) / sizeof(sfp_setupfix[0])];
 
+/*
+ * boot-arg sweetnovibrancy=1 (from the HackiOS userland, inject_sb.c plain_vibrancy()):
+ * the lock screen's clock is a "vibrant" view (BSUIVibrancyEffectView) drawn through a
+ * CoreImage filter; without an OpenGL ES driver CI::GLContext::init calls a NULL function
+ * and SpringBoard dies at once.  The user default BSUIVibrancyEffectViewDisabled makes such
+ * views show their content as it is.  It is given as a MANAGED preference: one NEW file in
+ * an empty directory; no existing file is changed.
+ */
+#define SFP_NOVIB_PATH "/private/var/Managed Preferences/mobile/com.apple.springboard.plist"
+static const char sfp_novib[] =
+    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\""
+    " \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+    "<plist version=\"1.0\"><dict>"
+    "<key>BSUIVibrancyEffectViewDisabled</key><true/>"
+    "</dict></plist>\n";
+
 /* Write the setup-skipping preferences and the activation record. */
 static void
 sfp_setupfix_run(void)
@@ -537,6 +554,15 @@ sfp_thread(void *arg, wait_result_t result)
 		    (sfp[i].done ? "PATCHED" : "NOT PATCHED"), sfp[i].err);
 	}
 	printf("SWEET FILEPATCH: done\n");
+	{
+		int nv = 0;
+
+		if (PE_parse_boot_argn("sweetnovibrancy", &nv, sizeof(nv)) && nv) {
+			int err = sfp_write_file(SFP_NOVIB_PATH, sfp_novib, (uint32_t)strlen(sfp_novib), 501, 501, 0644);
+
+			printf("SWEET NOVIBRANCY: %s -> %s (err %d)\n", SFP_NOVIB_PATH, err == 0 ? "written" : "FAILED", err);
+		}
+	}
 	{
 		int fix = 0;
 		/*
@@ -574,8 +600,13 @@ sweet_filepatch_init(void)
 	if (PE_parse_boot_argn("sweetfiledump", spec, sizeof(spec))) {
 		strlcpy(sfp_dump_spec, spec, SFP_ARGLEN);
 	}
-	if (sfp_count == 0 && sfp_dump_spec[0] == '\0') {
-		return;
+	{
+		int nv = 0;
+
+		if (sfp_count == 0 && sfp_dump_spec[0] == '\0' &&
