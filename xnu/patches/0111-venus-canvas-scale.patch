+		} else if (fWidth <= SWEET_FB_LOGICAL_W && fHeight <= SWEET_FB_LOGICAL_H) {
+			/* No canvas in the tree: present the iPhone X size. */
+			fLogicalW = SWEET_FB_LOGICAL_W;
+			fLogicalH = SWEET_FB_LOGICAL_H;
+		}
