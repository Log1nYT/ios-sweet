+/*
+ * The direction of a PMIC GPIO pad out of its MODE register.  The LV/MV
+ * pads (subtype 0x10/0x11) keep it in the low two bits, the digital pads
+ * in bits [6:4].
+ */
+static uint8_t
+keys_pmic_dir(uint8_t subtype, uint8_t mode)
+{
+	return (subtype >= 0x10u && subtype <= 0x13u) ? (uint8_t)(mode & 0x3u) :
+	    (uint8_t)((mode >> 4) & 0x7u);
+}
+
+/*
+ * Read the type, the subtype and the direction of one PMIC GPIO page.
+ * The type register (0x10 for a PMIC GPIO block) is the proof that the
+ * peripheral we talk to really is the GPIO block of the PMIC.
+ */
+static bool
+keys_pmic_page(uint16_t apid, uint8_t *subtype, uint8_t *mode)
+{
+	uint8_t type = 0, sub = 0, m = 0;
+
+	if (!keys_read(apid, KEYS_PG_TYPE, &type)) {
+		printf("SWEET KEYS: PMIC GPIO page does not answer (type)\n");
+		return false;
+	}
+	if (type != KEYS_PG_TYPE_PMIC) {
+		printf("SWEET KEYS: PMIC GPIO page type=%#x (expected %#x)\n",
+		    type, KEYS_PG_TYPE_PMIC);
+		return false;
+	}
+	if (!keys_read(apid, KEYS_PG_SUBTYPE, &sub) ||
+	    !keys_read(apid, KEYS_PG_MODE, &m)) {
+		printf("SWEET KEYS: PMIC GPIO page does not answer (subtype/mode)\n");
+		return false;
+	}
+	*subtype = sub;
+	*mode = m;
+	return true;
+}
