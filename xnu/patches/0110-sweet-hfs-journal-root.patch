+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET: find out whether the volume physically has a journal.
+ *
+ * A journaled HFS+ volume keeps a "journal info block" (JIB) at the block
+ * number the volume header points to (vhp->journalInfoBlock).  The JIB
+ * describes where the journal itself lives (byte offset + size inside the
+ * volume) and whether it still has to be initialized.
+ *
+ * Apple's driver only opens the journal when the last mounter was journal
+ * aware (vhp->lastMountedVersion == kHFSJMountVersion).  A volume that was
+ * created with "mkfs.hfsplus -J" / "newfs_hfs -J" and afterwards repaired
+ * with "fsck.hfsplus -f -y" keeps its journal but loses that marker, so the
+ * journal is never opened: every metadata update then goes straight to the
+ * disk (no transaction, no atomicity, no replay).
+ *
+ * We detect the journal physically: the JIB has to be readable and it has to
+ * describe an embedded (in-volume) journal of a plausible size that lies
+ * inside the volume.  Nothing else is touched, so a volume without a journal
+ * behaves exactly as before.
+ *
+ * Returns 1 if the volume has a journal, 0 if it does not.
+ *
+ * *used is set to 1 when the journal has been used before (the JIB has no
+ * "need init" flag).  The caller decides what to do with it: if the last
+ * mounter was not journal aware (fsck, a non-journaled HFS driver), the
+ * volume may have been changed behind our back, so the journal must NOT be
+ * replayed over it - it has to be reset (discarded) instead, exactly like
+ * hfs_late_journal_init() does.
+ */
+int
+hfs_sweet_journal_detect(struct hfsmount *hfsmp, HFSPlusVolumeHeader *vhp,
+			 off_t embeddedOffset, kauth_cred_t cred, int *used)
+{
+	JournalInfoBlock *jibp;
+	struct buf       *jinfo_bp;
+	int               sectors_per_fsblock;
+	int               retval;
+	uint32_t          blksize = hfsmp->hfs_logical_block_size;
+	uint32_t          blockSize = SWAP_BE32(vhp->blockSize);
+	uint32_t          jib_blkno;
+	uint32_t          jib_flags;
+	uint64_t          jib_offset;
+	uint64_t          jib_size;
+
+	*used = 0;
+
+	if (blockSize == 0 || blksize == 0)
+		return 0;
+
+	jib_blkno = SWAP_BE32(vhp->journalInfoBlock);
+	if (jib_blkno == 0)
+		return 0;
+
+	sectors_per_fsblock = blockSize / blksize;
+	if (sectors_per_fsblock == 0)
+		return 0;
+
+	jinfo_bp = NULL;
+	retval = (int)buf_meta_bread(hfsmp->hfs_devvp,
+			(daddr64_t)((embeddedOffset / blksize) +
+			            ((u_int64_t)jib_blkno * sectors_per_fsblock)),
+			hfsmp->hfs_physical_block_size, cred, &jinfo_bp);
+	if (retval) {
+		if (jinfo_bp)
+			buf_brelse(jinfo_bp);
+		return 0;
+	}
+
+	jibp = (JournalInfoBlock *)buf_dataptr(jinfo_bp);
+	jib_flags  = SWAP_BE32(jibp->flags);
+	jib_offset = SWAP_BE64(jibp->offset);
+	jib_size   = SWAP_BE64(jibp->size);
+
+	/*
+	 * Only an embedded journal is safe to enable here: an external
+	 * journal lives on another device and needs its own discovery.
+	 */
+	if (!(jib_flags & kJIJournalInFSMask)) {
+		buf_brelse(jinfo_bp);
+		return 0;
+	}
+
+	/*
+	 * The journal has to be inside the volume, aligned to an allocation
+	 * block, of a plausible size (the same limits journal_open() uses)
+	 * and it must not overlap the volume header.
+	 */
+	if (jib_offset == 0 ||
+	    (jib_offset % (uint64_t)blockSize) != 0 ||
+	    jib_size < (uint64_t)(256*1024) ||
+	    jib_size > (uint64_t)(1024*1024*1024) ||
+	    (jib_offset + jib_size) > hfsmp->hfs_logical_bytes ||
+	    jib_offset < (uint64_t)(2 * blockSize)) {
+		buf_brelse(jinfo_bp);
+		return 0;
+	}
+
+	/*
+	 * A journal without the "need init" flag has been used before: the
+	 * caller has to decide whether it may be replayed.
+	 */
+	if (!(jib_flags & kJIJournalNeedInitMask))
+		*used = 1;
+
+	buf_brelse(jinfo_bp);
+	return 1;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
