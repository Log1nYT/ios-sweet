+/* Install (or re-install) the default route via 192.168.7.1 on ue0. */
+static void
+ud_route_add(bool verbose)
+{
+	struct sockaddr_in dst, gw, mask;
+	bzero(&dst, sizeof(dst));
+	dst.sin_len = sizeof(dst);
+	dst.sin_family = AF_INET;
+	bzero(&gw, sizeof(gw));
+	gw.sin_len = sizeof(gw);
+	gw.sin_family = AF_INET;
+	gw.sin_addr.s_addr = htonl(0xc0a80701);         /* 192.168.7.1 */
+	bzero(&mask, sizeof(mask));
+	mask.sin_len = sizeof(mask);
+	mask.sin_family = AF_INET;
+	int rerr = rtrequest(RTM_ADD, (struct sockaddr *)&dst,
+	    (struct sockaddr *)&gw, (struct sockaddr *)&mask,
+	    RTF_UP | RTF_GATEWAY | RTF_STATIC, NULL);
+	if (verbose || (rerr != 0 && rerr != EEXIST)) {
+		printf("SWEET USB: default route via 192.168.7.1 %s (err %d)\n",
+		    (rerr != 0 && rerr != EEXIST) ? "FAILED" : "added", rerr);
+	}
+}
+
+/*
+ * configd clears any route it doesn't recognize shortly after it starts
+ * (seen once, right after "exec configd"). ue0 has no NetworkInterfaces
+ * entry for configd to adopt it properly, so instead of fighting configd's
+ * userland config (would need root-image changes we don't have), just
+ * keep re-asserting the route from the kernel every 3s. rtrequest(RTM_ADD)
+ * on an already-present route returns EEXIST, which is fine.
+ * ponytail: polling, not event-driven off route-delete notifications;
+ * upgrade to an eventhandler hook on rt_setexpire/rtrequest if 3s staleness
+ * ever matters.
+ */
+static void
+ud_route_keeper(void *arg __unused, wait_result_t wr __unused)
+{
+	for (;;) {
+		delay(3 * 1000 * 1000);
+		ud_route_add(false);
+	}
+}
+
 /* ue0, 192.168.7.2/24 (the host side is 192.168.7.1). */
 static void
 ud_if_create(void)
