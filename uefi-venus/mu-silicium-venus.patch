@@ -324,6 +328,9 @@ PlatformBootManagerUnableToBoot ()
 {
   EFI_STATUS Status;
 
+  // Nothing else to boot: hand over to the XNU loader (does not return)
+  XnuLoaderMain ();
+
   // Execute Secondary Unable To Boot
   DeviceBootManagerUnableToBoot ();
 

