+	int letterbox = 0;
+	PE_parse_boot_argn("sweetfb_letterbox", &letterbox, sizeof(letterbox));
+	if (fLogicalW < fWidth && fLogicalH < fHeight && !letterbox) {
+		/* The canvas is smaller than the panel: scale it up to fill it. */
+		fScaleUp = true;
+		fScaleX = (fWidth << 16) / fLogicalW;
+		fScaleY = (fHeight << 16) / fLogicalH;
+		fInvScaleX = (fLogicalW << 16) / fWidth;
+		fInvScaleY = (fLogicalH << 16) / fHeight;
+	}
