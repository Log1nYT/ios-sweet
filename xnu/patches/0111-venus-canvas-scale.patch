 	uint32_t      fLogicalW, fLogicalH;     /* size reported to userland */
 	int32_t       fOffX, fOffY;             /* logical origin of the panel */
+	uint32_t      fScaleX, fScaleY;         /* panel px per canvas px, 16.16 */
+	uint32_t      fInvScaleX, fInvScaleY;   /* canvas px per panel px, 16.16 */
+	bool          fScaleUp;         /* the canvas is smaller than the panel */
 	uintptr_t     fPixels;          /* kernel mapping of the panel memory */
