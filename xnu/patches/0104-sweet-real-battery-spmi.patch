+	case 0x15:	/* TYPEC */
+	case 0x16:	/* MISC  */
+	case 0x31:	/* ADC7  (PMK8350 VADC) */
+	case 0x47:	/* BCL v5 (PM8350B battery current limit) */
+	case 0x48:	/* QG    (PM6150 fuel gauge, sweet board) */
+		return true;
+	default:
+		return false;
+	}
