@@ -276,6 +277,9 @@ PlatformBootManagerPriorityBoot (IN OUT UINT16 **BootNext)
   // Get Boot Manager Flag
   BootManagerFlag = EnterBootManager ();
   if (BootManagerFlag == FALSE) {
+    // No Volume Up: this build has no OS on the phone, start the XNU loader (does not return).
