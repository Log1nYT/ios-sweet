 }
 
+/*
+ * Boot-arg regtrace=1: report the registry properties user space asks for and does not
+ * find (regtrace=2: every property asked for). Shows what a daemon expects of a driver.
+ */
+static TUNABLE(uint32_t, regtrace_level, "regtrace", 0);
+
+static void
+regtrace_report(IORegistryEntry * entry, const char * property, bool found)
+{
+	char procname[32] = "?";
+
+	if (regtrace_level == 0 || (found && regtrace_level < 2)) {
+		return;
+	}
+	proc_selfname(procname, sizeof(procname));
+	IOLog("regtrace: %s[%d] %s(%s).%s %s\n", procname, proc_selfpid(), entry->getName(),
+	    entry->getMetaClass()->getClassName(), property, found ? "found" : "MISSING");
+}
+
