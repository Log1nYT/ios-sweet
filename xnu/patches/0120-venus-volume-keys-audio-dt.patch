+/*
+ * Open one PMIC GPIO pad as a key.  The direction is read BEFORE the
+ * value: a pad the PMIC drives (output) is never touched and the key
+ * stays withheld, exactly as before.  Only a pad that reads back as
+ * "input" is used.
+ */
+static bool
+keys_vol_open(int idx, uint8_t pin)
+{
+	uint16_t periph = (uint16_t)(KEYS_PMIC_GPIO_BASE + pin);
+	uint16_t ppid = (uint16_t)((KEYS_VENUS_SID << 8) | periph);
+	uint16_t apid = keys_find_apid(ppid, keys_count);
+	uint8_t sub = 0, mode = 0, dir = 0, en = 0, pull = 0, raw = 0;
+	const char *name = (idx == KEYS_VK_UP) ? "up" : "down";
+
+	keys_vkey[idx].apid = KEYS_NO_APID;
+	keys_vkey[idx].pin = pin;
+	if (apid == KEYS_NO_APID) {
+		printf("SWEET KEYS: PM8350 GPIO%u (peripheral %#x, PPID %#x) is not in the SPMI table\n",
+		    pin, periph, ppid);
+		return false;
+	}
+	if (!keys_pmic_page(apid, &sub, &mode)) {
+		printf("SWEET KEYS: PM8350 GPIO%u: no direction; volume-%s withheld\n",
+		    pin, name);
+		return false;
+	}
+	dir = keys_pmic_dir(sub, mode);
+	(void)keys_read(apid, KEYS_PG_EN, &en);
+	(void)keys_read(apid, KEYS_PG_PULL, &pull);
+	if (dir == KEYS_DIR_OUTPUT) {
+		printf("SWEET KEYS: PM8350 GPIO%u is an OUTPUT (the PMIC drives the pin); volume-%s withheld, PMIC unchanged\n",
+		    pin, name);
+		return false;
+	}
+	if (dir != KEYS_DIR_INPUT) {
+		/*
+		 * Not provably an input.  Only sweetkeyvol=2 may ask the
+		 * PMIC for the input direction; even then the write only
+		 * ever asks for "input" (never a driven pin) and the
+		 * result is read back before it is used.
+		 */
+		uint8_t after = 0;
+
+		if (keys_vol_mode < 2) {
+			printf("SWEET KEYS: PM8350 GPIO%u direction %u is not 'input'; volume-%s withheld\n",
+			    pin, dir, name);
+			return false;
+		}
+		if (!keys_write(apid, KEYS_PG_MODE, 0x00u)) {
+			printf("SWEET KEYS: PM8350 GPIO%u: the direction write did not complete; volume-%s withheld\n",
+			    pin, name);
+			return false;
+		}
+		if (!keys_read(apid, KEYS_PG_MODE, &after) ||
+		    keys_pmic_dir(sub, after) != KEYS_DIR_INPUT) {
+			printf("SWEET KEYS: PM8350 GPIO%u: the direction write did not read back as 'input' (%#x); volume-%s withheld\n",
+			    pin, after, name);
+			return false;
+		}
+		printf("SWEET KEYS: PM8350 GPIO%u: mode %#x -> %#x (input), read back verified\n",
+		    pin, mode, after);
+		dir = KEYS_DIR_INPUT;
+	}
+	if (!keys_read(apid, KEYS_PG_RT_STS, &raw)) {
+		printf("SWEET KEYS: PM8350 GPIO%u: the level register does not answer; volume-%s withheld\n",
+		    pin, name);
+		return false;
+	}
+	keys_vkey[idx].apid = apid;
+	keys_vkey[idx].state = (raw & 1u) ? 0u : 1u;
+	keys_vkey[idx].last = keys_vkey[idx].state;
+	keys_vkey[idx].stable = 0;
+	printf("SWEET KEYS: PM8350 GPIO%u page %#x PPID %#x APID %u subtype %#x mode %#x dir %u en %#x pull %#x level %#x -> volume-%s live\n",
+	    pin, periph, ppid, apid, sub, mode, dir, en, pull, raw, name);
+	return true;
+}
