+/*
+ * Write one byte of a PMIC register (EXT_WRITEL).  The command word is
+ * the read command with the read bit cleared and the data byte in bits
+ * 23:16.  It is ONLY used to ask the PMIC for the "input" direction of
+ * a pad: the pin is never driven, and the caller reads the register back
+ * and compares before it trusts the result.
+ */
+static bool
+keys_write(uint16_t apid, uint16_t addr, uint8_t val)
+{
+	uint32_t off = 0x80u * apid;
+	uint32_t cmd = ((uint32_t)val << 16) | ((uint32_t)(addr & 0xffu) << 4);
+
+	if (apid == KEYS_NO_APID) {
+		return false;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(keys_obs + off) = cmd; /* EXT_WRITEL, one byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = keys_rd(keys_obs, off + 0x08u);
+		if (status & 1u) {
+			return (status & 0x0eu) == 0;
+		}
+		delay(1);
+	}
+	return false;
+}
