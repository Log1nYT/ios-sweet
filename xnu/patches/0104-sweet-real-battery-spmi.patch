+/* Write one byte of a whitelisted register on the battery SID.
+ * The write goes through the arbiter's read/write channel (the observer
+ * is read only) and is verified by reading the register back. */
+int
+sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value)
+{
+	if (!sp_ready || !sp_writable || !sp_write_allowed(sid, addr)) {
+		printf("SWEET BATTERY: SPMI write refused sid=%u addr=%#x\n",
+		    sid, addr);
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | (addr >> 8));
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	/* Only the APPS (EE 0) may write this APID: another owner (the ADSP
+	 * charger protection domain) would race us. */
+	if ((sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u) != 0) {
+		printf("SWEET BATTERY: SPMI write refused sid=%u addr=%#x APID=%u not APPS owned\n",
+		    sid, addr, apid);
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	unsigned off = SP_CHNL_STRIDE * apid;
+	uint32_t cmd = (SP_OP_EXT_WRITE << 27) | ((addr & 0xffu) << 4);
+	bool done = false;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_chnl + off + SP_WDATA0) = value;
+	*(volatile uint32_t *)(sp_chnl + off + SP_CMD) = cmd; /* EXT_WRITE, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_chnl, off + SP_STATUS);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				printf("SWEET BATTERY: SPMI write failed sid=%u addr=%#x val=%#x status=%#x\n",
+				    sid, addr, value, status);
+			} else {
+				done = true;
+			}
+			break;
+		}
+		delay(1);
+	}
+	if (!done) {
+		sp_poisoned[apid] = true;
+		printf("SWEET BATTERY: SPMI write timeout sid=%u addr=%#x APID=%u disabled\n",
+		    sid, addr, apid);
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	IOLockUnlock(sp_lock);
+	/* The write must be visible in the observer before it is trusted. */
+	uint8_t back = 0;
+	if (sweet_spmi_read(sid, addr, &back) || back != value) {
+		printf("SWEET BATTERY: SPMI write verify failed sid=%u addr=%#x (%s) wrote=%#x read=%#x\n",
+		    sid, addr, sp_write_name(addr), value, back);
+		return -1;
+	}
+	printf("SWEET BATTERY: SPMI write sid=%u addr=%#x (%s) val=%#x verified\n",
+	    sid, addr, sp_write_name(addr), value);
+	return 0;
+}
+
+/* Read a register, modify the masked bits and write it back. */
+int
+sweet_spmi_update(unsigned sid, unsigned addr, uint8_t mask, uint8_t value)
+{
+	uint8_t old = 0;
+	if (sweet_spmi_read(sid, addr, &old)) {
+		return -1;
+	}
+	uint8_t next = (uint8_t)((old & (uint8_t)~mask) | (value & mask));
+	if (next == old) {
+		return 0; /* already in the wanted state */
+	}
+	return sweet_spmi_write(sid, addr, next);
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
