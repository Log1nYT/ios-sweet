+/*
+ * The canvas is the size the userland renders at; it comes from the device
+ * tree (/arm-io/disp0 canvas-width/canvas-height), the same properties
+ * IOMobileFramebuffer.framework reads. GetDisplaySize(8) must report it:
+ * the framework sizes the render target from the canvas and the display
+ * mode from GetDisplaySize, and if the two disagree backboardd swaps empty
+ * frames (a picture that never appears, no crash).
+ *
+ * The panel (boot_args.Video, the ABL splash memory) can be larger than the
+ * canvas (venus: 1440x3200 panel, 1125x2436 canvas). The canvas is then
+ * scaled up to fill the panel (nearest neighbour); boot-arg
+ * sweetfb_letterbox=1 draws it 1:1 centered instead.
+ */
 
 class IOMobileFramebuffer : public IOService {
 	OSDeclareDefaultStructors(IOMobileFramebuffer);
@@ -109,6 +122,9 @@
