--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -5027,6 +5027,57 @@
 	           uap->class, uap->dpflags, AT_FDCWD, AUTH_OPEN_NOAUTHFD, UIO_USERSPACE, retval);
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET: boot-arg sweetteewrite=name,name (shared with 0091). Logs every open()
+ * by a named process as "|name| open(path) flags=.. -> errno" (failures only),
+ * so a daemon's missing directories/containers show up in the live USB log.
+ */
+static void
+sweet_open_tee(user_addr_t path, int flags, int error)
+{
+	static char names[128];
+	static int parsed;
+	char name[32];
+	char p[160];
+	size_t plen = 0;
+
+	if (error == 0) {
+		return;
+	}
+	if (!parsed) {
+		names[0] = '\0';
+		(void)PE_parse_boot_argn("sweetteewrite", names, sizeof(names));
+		parsed = 1;
+	}
+	if (names[0] == '\0') {
+		return;
+	}
+	proc_selfname(name, (int)sizeof(name));
+	size_t nl = strlen(name);
+	bool match = false;
+	for (const char *t = names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == nl && nl > 0 && strncmp(t, name, nl) == 0) {
+			match = true;
+			break;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	if (!match) {
+		return;
+	}
+	if (copyinstr(path, p, sizeof(p), &plen) != 0) {
+		strlcpy(p, "?", sizeof(p));
+	}
+	printf("|%s| open(%s) flags=%#x -> errno %d\n", name, p, flags, error);
+}
+#endif
+
 static int
 openat_internal(vfs_context_t ctx, user_addr_t path, int flags, int mode,
     int fd, enum uio_seg segflg, int *retval)
@@ -5054,6 +5105,11 @@
