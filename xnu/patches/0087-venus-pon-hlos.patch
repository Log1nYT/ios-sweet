diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index a148608..ada2dd4 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -20,7 +20,8 @@ void sweet_keys_init(void);
 #define KEYS_CORE_PA     0x0c440000u
 #define KEYS_OBS_PA      0x0e600000u
 #define KEYS_CNFG_PA     0x0c40a000u
-#define KEYS_PON_RT      0x0810u
+/* sweet PM6150 PON 0x0800; venus PMK8350 PON_HLOS 0x1300 (KPDPWR bit 0, RESIN bit 1) */
+static uint16_t keys_pon_ppid = 0x008, keys_pon_rt = 0x0810u;
 #define KEYS_GPIO_RT     0xc110u
 #define KEYS_NO_APID     0xffffu
 
@@ -99,7 +100,7 @@ keys_thread(void *arg, wait_result_t result)
 	(void)result;
 	for (;;) {
 		uint8_t pon = 0, gpio = 0;
-		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+		bool pok = keys_read(keys_pon_apid, keys_pon_rt, &pon);
 		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
 		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
 		if (!pok || !gok) {
@@ -151,10 +152,15 @@ sweet_keys_init(void)
 		    keys_version, count);
 		return;
 	}
-	keys_pon_apid = keys_find_apid(0x008, count);
+	int venus = 0;
+	if (PE_parse_boot_argn("venus", &venus, sizeof(venus)) && venus) {
+		keys_pon_ppid = 0x013;
+		keys_pon_rt = 0x1310u;
+	}
+	keys_pon_apid = keys_find_apid(keys_pon_ppid, count);
 	keys_gpio_apid = keys_find_apid(0x4c1, count);
 	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
-	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+	bool pok = keys_read(keys_pon_apid, keys_pon_rt, &pon);
 	bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
 	bool mok = keys_read(keys_gpio_apid, 0xc140, &mode);
 	bool eok = keys_read(keys_gpio_apid, 0xc146, &en);
